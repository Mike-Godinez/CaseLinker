    "https://ontology.unifiedcyberontology.org/uco/core/description": [
      {
        "@value": "participating in a conspiracy between October 2000 and September 2002 in which they used a minor for prostitution activities in Massachusetts, Maine, Connecticut, Rhode Island and New Hampshire"
      }
    ],
