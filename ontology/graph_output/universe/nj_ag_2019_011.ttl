<https://w3id.org/caselinker/resource/case/nj_ag_2019_011/admission/1> a <https://cacontology.projectvic.org/undercover#IncriminatingStatement> ;
    rdfs:label "knowingly used file-sharing software to make multiple files of child pornography readily available for any other user..." ;
    dcterms:source <https://www.njoag.gov/man-who-possessed-over-12000-files-of-child-pornography-sentenced-to-five-years-in-prison-for-distributing-child-pornography-online> ;
    ns3:description "knowingly used file-sharing software to make multiple files of child pornography readily available for any other user to download from a “shared folder” on his computer" ;
    ns4:admissionContext "under Megan’s Law and will be subject to parole supervision for life. In pleading guilty, Brutto admitted he knowingly used file-sharing..." ;
    ns4:admissionFrame "admitted_he_she" ;
    ns4:admissionTheme "harm_conduct",
        "tech_use" ;
